new file mode 100644
index 0000000..ce741ad
--- /dev/null
+++ b/user/sleep.c
@@ -0,0 +1,16 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if(argc != 2){
+    printf("Sleep needs one argument!\n");
+    exit(-1);
+  }
+
+  int ticks = atoi(argv[1]);
+  sleep(ticks);
+  printf("Sleep %d\n", ticks);
+  exit(0);
+}
